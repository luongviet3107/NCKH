# Backend runtime
ENVIRONMENT=development
# Defaults to backend/autods.db. Override only if you provide your own database.
# DATABASE_URL=postgresql+psycopg2://autods:autods@localhost:5432/autods
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Optional API-key protection (leave empty for local single-user use)
AUTODS_API_KEY=

# Upload and execution limits
MAX_UPLOAD_MB=50
MAX_AGENT_RUNTIME_SECONDS=300

# Optional OpenAI-compatible LLM for grounded narratives only.
# All quantitative analytics and ML work without an LLM key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional LangSmith tracing for the LangGraph workflow
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autods

# Demo data is seeded automatically when the database is empty
SEED_DEMO_DATA=true
